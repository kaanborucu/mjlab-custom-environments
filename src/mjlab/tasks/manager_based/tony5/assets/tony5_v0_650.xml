<mujoco model="tony5_v0_650">
  <!--
    FlyFishRC Tony 5 V0 quadrotor model for MJLab / MuJoCo-Warp.

    Coordinate convention:
      +X = forward
      +Y = left
      +Z = up

    Rotor order used throughout the model:
      FL, FR, RR, RL

    Positive hinge velocity always means positive commanded rotor speed.
    Physical spin direction is encoded in the hinge axis:
      FL = CW   -> axis  0 0 -1
      FR = CCW  -> axis  0 0  1
      RR = CW   -> axis  0 0 -1
      RL = CCW  -> axis  0 0  1

    V0 baseline: Tattu R-Line 650 mAh 6S configuration.

    Estimated dynamics values to replace after measurement:
      total mass           = 0.285 kg
      quad_base mass       = 0.257 kg
      each rotating body   = 0.007 kg
      quad_base inertia    = 4.2e-4 4.4e-4 7.9e-4 kg*m^2
      rotor inertia        = 1.7e-6 1.7e-6 3.3e-6 kg*m^2
      kT                   = 1.00e-6 N/(rad/s)^2   [implemented in MJLab]
      kQ                   = 1.25e-8 Nm/(rad/s)^2 [implemented in MJLab]
      max rotor speed      = 2827.43 rad/s ~= 27000 RPM
      hover rotor speed    = ~836 rad/s ~= 7980 RPM

    IMPORTANT:
      No <actuator> section is included intentionally.
      Use MJLab BuiltinDcMotorActuatorCfg on the four rotor joints with
      velocity input. This avoids duplicating actuators in MJCF and MJLab.

      Propeller thrust and aerodynamic reaction torque are NOT generated by
      rigid-body dynamics or the DC motor actuator. Apply them per physics
      substep in MJLab from the measured hinge speed:
        thrust_i = kT * omega_i^2
        aero_torque_i = -sign(spin_i) * kQ * omega_i^2
  -->

  <compiler angle="radian" autolimits="true"/>

  <!-- 1 kHz V0 physics. implicitfast is a good default for motor-driven joints. -->
  <option timestep="0.001" integrator="implicitfast" gravity="0 0 -9.80665"/>

  <default>
    <joint damping="0" frictionloss="0" armature="0"/>

    <!-- Visual-only geometry: no collision and no contribution to inertia. -->
    <default class="visual">
      <geom contype="0" conaffinity="0" group="1" mass="0"/>
    </default>

    <!-- Exactly one collision geom for the complete airframe. -->
    <default class="collision">
      <geom contype="1" conaffinity="1" group="3" mass="0"
            friction="0.8 0.02 0.002" solref="0.01 1"/>
    </default>
  </default>

  <worldbody>
    <body name="quad_base" pos="0 0 0.30">
      <freejoint name="root"/>

      <!--
        Fixed portion of the aircraft.
        0.257 kg + 4 * 0.007 kg rotating bodies = 0.285 kg total.
      -->
      <inertial pos="0 0 0"
                mass="0.257"
                diaginertia="4.2e-4 4.4e-4 7.9e-4"/>

      <!-- Single simplified collision body: 130 x 130 x 35 mm. -->
      <geom name="main_collision"
            class="collision"
            type="box"
            size="0.065 0.065 0.0175"
            rgba="0.2 0.2 0.2 0.0"/>

      <!-- Simple central frame/electronics visual. -->
      <geom name="center_visual"
            class="visual"
            type="box"
            size="0.032 0.032 0.009"
            rgba="0.12 0.12 0.14 1"/>

      <!-- Approximate 650 mAh battery visual; mass is already in quad_base inertial. -->
      <geom name="battery_visual"
            class="visual"
            type="box"
            pos="0 0 0.026"
            size="0.031 0.0155 0.018"
            rgba="0.30 0.12 0.12 1"/>

      <!-- Four simple True-X arms, visual only. -->
      <geom name="arm_fl" class="visual" type="capsule"
            fromto="0 0 0  0.076014 0.076014 0"
            size="0.004" rgba="0.08 0.08 0.09 1"/>
      <geom name="arm_fr" class="visual" type="capsule"
            fromto="0 0 0  0.076014 -0.076014 0"
            size="0.004" rgba="0.08 0.08 0.09 1"/>
      <geom name="arm_rr" class="visual" type="capsule"
            fromto="0 0 0  -0.076014 -0.076014 0"
            size="0.004" rgba="0.08 0.08 0.09 1"/>
      <geom name="arm_rl" class="visual" type="capsule"
            fromto="0 0 0  -0.076014 0.076014 0"
            size="0.004" rgba="0.08 0.08 0.09 1"/>

      <!-- Fixed motor stator visuals. Their mass is included in quad_base. -->
      <geom class="visual" type="cylinder" pos="0.076014 0.076014 0"
            size="0.013 0.005" rgba="0.16 0.16 0.18 1"/>
      <geom class="visual" type="cylinder" pos="0.076014 -0.076014 0"
            size="0.013 0.005" rgba="0.16 0.16 0.18 1"/>
      <geom class="visual" type="cylinder" pos="-0.076014 -0.076014 0"
            size="0.013 0.005" rgba="0.16 0.16 0.18 1"/>
      <geom class="visual" type="cylinder" pos="-0.076014 0.076014 0"
            size="0.013 0.005" rgba="0.16 0.16 0.18 1"/>

      <!-- IMU/reference site at the modeled base COM. -->
      <site name="imu_site" pos="0 0 0" size="0.004" rgba="0 1 0 1"/>

      <!-- ================================================================ -->
      <!-- FRONT LEFT: CW                                                   -->
      <!-- ================================================================ -->
      <body name="rotor_fl" pos="0.076014 0.076014 0">
        <joint name="rotor_fl_joint" type="hinge" axis="0 0 -1" limited="false"/>
        <inertial pos="0 0 0.006"
                  mass="0.007"
                  diaginertia="1.7e-6 1.7e-6 3.3e-6"/>
        <geom class="visual" type="cylinder" pos="0 0 0.006"
              size="0.012 0.006" rgba="0.20 0.20 0.22 1"/>
        <geom class="visual" type="box" pos="0 0 0.013"
              size="0.0635 0.0035 0.0006" rgba="0.65 0.65 0.68 0.75"/>
        <site name="rotor_fl_site" pos="0 0 0.013" size="0.003" rgba="1 0.2 0.2 1"/>
      </body>

      <!-- ================================================================ -->
      <!-- FRONT RIGHT: CCW                                                 -->
      <!-- ================================================================ -->
      <body name="rotor_fr" pos="0.076014 -0.076014 0">
        <joint name="rotor_fr_joint" type="hinge" axis="0 0 1" limited="false"/>
        <inertial pos="0 0 0.006"
                  mass="0.007"
                  diaginertia="1.7e-6 1.7e-6 3.3e-6"/>
        <geom class="visual" type="cylinder" pos="0 0 0.006"
              size="0.012 0.006" rgba="0.20 0.20 0.22 1"/>
        <geom class="visual" type="box" pos="0 0 0.013"
              size="0.0635 0.0035 0.0006" rgba="0.65 0.65 0.68 0.75"/>
        <site name="rotor_fr_site" pos="0 0 0.013" size="0.003" rgba="0.2 0.4 1 1"/>
      </body>

      <!-- ================================================================ -->
      <!-- REAR RIGHT: CW                                                   -->
      <!-- ================================================================ -->
      <body name="rotor_rr" pos="-0.076014 -0.076014 0">
        <joint name="rotor_rr_joint" type="hinge" axis="0 0 -1" limited="false"/>
        <inertial pos="0 0 0.006"
                  mass="0.007"
                  diaginertia="1.7e-6 1.7e-6 3.3e-6"/>
        <geom class="visual" type="cylinder" pos="0 0 0.006"
              size="0.012 0.006" rgba="0.20 0.20 0.22 1"/>
        <geom class="visual" type="box" pos="0 0 0.013"
              size="0.0635 0.0035 0.0006" rgba="0.65 0.65 0.68 0.75"/>
        <site name="rotor_rr_site" pos="0 0 0.013" size="0.003" rgba="1 0.2 0.2 1"/>
      </body>

      <!-- ================================================================ -->
      <!-- REAR LEFT: CCW                                                   -->
      <!-- ================================================================ -->
      <body name="rotor_rl" pos="-0.076014 0.076014 0">
        <joint name="rotor_rl_joint" type="hinge" axis="0 0 1" limited="false"/>
        <inertial pos="0 0 0.006"
                  mass="0.007"
                  diaginertia="1.7e-6 1.7e-6 3.3e-6"/>
        <geom class="visual" type="cylinder" pos="0 0 0.006"
              size="0.012 0.006" rgba="0.20 0.20 0.22 1"/>
        <geom class="visual" type="box" pos="0 0 0.013"
              size="0.0635 0.0035 0.0006" rgba="0.65 0.65 0.68 0.75"/>
        <site name="rotor_rl_site" pos="0 0 0.013" size="0.003" rgba="0.2 0.4 1 1"/>
      </body>
    </body>
  </worldbody>

  <!--
    Sensors are noiseless in V0 and are convenient for debugging / observations.
    The rotor speeds can also be read directly from qvel in MJLab.
  -->
  <sensor>
    <gyro name="imu_gyro" site="imu_site"/>
    <accelerometer name="imu_accel" site="imu_site"/>

    <jointvel name="rotor_fl_speed" joint="rotor_fl_joint"/>
    <jointvel name="rotor_fr_speed" joint="rotor_fr_joint"/>
    <jointvel name="rotor_rr_speed" joint="rotor_rr_joint"/>
    <jointvel name="rotor_rl_speed" joint="rotor_rl_joint"/>
  </sensor>
</mujoco>
