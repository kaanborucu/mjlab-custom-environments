<?xml version='1.0' encoding='UTF-8'?>
<mujoco model="bird_5dof_paper_scaled_tail_shoulders_crow_visual">
  <!--
    Five-DoF bird-inspired flapping-wing robot for mjlab / MuJoCo Warp.

    Actuated joints:
      1. left_flap
      2. left_feather
      3. right_flap
      4. right_feather
      5. tail_pitch

    Coordinate convention:
      +X forward
      +Y left
      +Z upward

    Design targets:
      wingspan: 0.995 m
      elliptical mean wing chord: approximately 0.170 m
      approximate total mass: 0.310 kg
      exactly one collision geom: base_collision

    Aerodynamics:
      - left and right wings use MuJoCo's ellipsoid fluid model
      - tail uses MuJoCo's ellipsoid fluid model
      - central body uses one simple ellipsoid fluid geom
      - each flap frame uses one small invisible shoulder ellipsoid
      - all decorative geoms are visual-only and non-colliding

    Note:
      The paper specifies the overall robot scale and five actuated DoFs,
      but does not provide exact tail dimensions or mass properties.
      The tail geometry below is therefore a simple engineering approximation.
  -->
  <compiler angle="radian" autolimits="true" inertiafromgeom="false" balanceinertia="false"/>
  <!-- These atmospheric settings work when loaded directly in MuJoCo.
       In mjlab, set density, viscosity, wind, and has_fluid again in SimulationCfg. -->
  <option timestep="0.002" integrator="implicitfast" gravity="0 0 -9.81" density="1.225" viscosity="1.81e-5" wind="0 0 0"/>
  <statistic center="0 0 0" extent="1.15"/>
