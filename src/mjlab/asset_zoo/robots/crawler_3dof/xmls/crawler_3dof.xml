<mujoco model="three_dof_ground_crawler_cylinder_3d">
  <!--
    Minimal 3-DoF crawling robot for MuJoCo / MJLab.

    Structure:
      segment_0 - joint_1 - segment_1 - joint_2 - segment_2 - joint_3 - segment_3

    Geometry:
      * Every body segment uses a longitudinal cylinder for collision.
      * Every body segment uses an identical cylinder for visualization.
      * No wheels, legs, pads, or other contact devices.

    Joint-axis arrangement:
      * joint_1: yaw about the local Z axis.
      * joint_2: pitch about the local Y axis.
      * joint_3: pitch about the local Y axis.

    This gives a genuine 3D configuration space instead of three planar yaw joints.
    All joint and actuator command limits are -90 to +90 degrees.
  -->

  <compiler angle="radian" autolimits="true" inertiafromgeom="true"/>

  <default>
    <!--
      Long cylinder collision geometry. MuJoCo cylinder size values are radius
      and half-length. The quaternion rotates its local Z axis onto local X.
      Full dimensions are 140 mm long x 60 mm diameter.
    -->
    <default class="link_collision">
      <geom
        type="cylinder"
        size="0.030 0.070"
        quat="0.7071067812 0 0.7071067812 0"
        mass="0.055"
        friction="1.10 0.005 0.0001"
        solref="0.006 1"
        solimp="0.90 0.95 0.001"
        condim="4"
        contype="1"
        conaffinity="1"
        margin="0.001"
        rgba="0 0 0 0"/>
    </default>

    <!-- Identical cylinder used only for visualization. -->
    <default class="link_visual">
      <geom
        type="cylinder"
        size="0.030 0.070"
        quat="0.7071067812 0 0.7071067812 0"
        mass="0"
        contype="0"
        conaffinity="0"
        group="1"/>
    </default>

    <!--
      Servo mass near each hinge. It contributes mass/inertia but is invisible
      and non-colliding, so the visible robot remains purely cylindrical.
    -->
    <default class="servo_mass">
      <geom
        type="ellipsoid"
        size="0.0203 0.0103 0.0200"
        mass="0.063"
        rgba="0 0 0 0"
        contype="0"
        conaffinity="0"
        group="3"/>
    </default>

    <!-- -90 to +90 degrees. Axis is overridden per joint below. -->
    <default class="crawler_joint">
      <joint
        type="hinge"
        range="-1.5707963268 1.5707963268"
        limited="true"
        damping="0.30"
        armature="0.002"
        frictionloss="0.05"
        margin="0.035"
        solreflimit="0.004 1"
        solimplimit="0.90 0.99 0.001"/>
    </default>

    <!-- Position command limits also equal -90 to +90 degrees. -->
    <default class="crawler_servo">
      <position
        kp="35"
        kv="1.5"
        ctrlrange="-1.5707963268 1.5707963268"
        ctrllimited="true"
        forcerange="-3.491 3.491"
        forcelimited="true"/>
    </default>
  </default>

  <worldbody>
    <!-- Root height equals the cylinder radius plus a small clearance. -->
    <body name="segment_0" pos="0 0 0.031">
      <freejoint name="root"/>

      <!-- Segment 0 extends from x=0.00 to x=0.14 m. -->
      <geom name="segment_0_collision" class="link_collision" pos="0.070 0 0"/>
      <geom name="segment_0_visual" class="link_visual" pos="0.070 0 0"
            rgba="0.10 0.28 0.55 1"/>

      <site name="imu_site" pos="0.070 0 0.022" size="0.008" rgba="1 0.2 0.2 1"/>
      <site name="base_reference" pos="0.070 0 0" size="0.006" rgba="0.2 1 0.2 1"/>

      <!-- Joint 1: yaw around local Z. -->
      <body name="segment_1" pos="0.140 0 0">
        <joint name="joint_1" class="crawler_joint" axis="0 0 1"/>
        <geom name="servo_1_mass" class="servo_mass" pos="0 0 0"/>
        <geom name="segment_1_collision" class="link_collision" pos="0.070 0 0"/>
        <geom name="segment_1_visual" class="link_visual" pos="0.070 0 0"
              rgba="0.12 0.40 0.70 1"/>

        <!-- Joint 2: pitch around local Y. -->
        <body name="segment_2" pos="0.140 0 0">
          <joint name="joint_2" class="crawler_joint" axis="0 1 0"/>
          <geom name="servo_2_mass" class="servo_mass" pos="0 0 0"/>
          <geom name="segment_2_collision" class="link_collision" pos="0.070 0 0"/>
          <geom name="segment_2_visual" class="link_visual" pos="0.070 0 0"
                rgba="0.12 0.52 0.72 1"/>

          <!-- Joint 3: pitch around local Y. -->
          <body name="segment_3" pos="0.140 0 0">
            <joint name="joint_3" class="crawler_joint" axis="0 1 0"/>
            <geom name="servo_3_mass" class="servo_mass" pos="0 0 0"/>
            <geom name="segment_3_collision" class="link_collision" pos="0.070 0 0"/>
            <geom name="segment_3_visual" class="link_visual" pos="0.070 0 0"
                  rgba="0.15 0.62 0.66 1"/>

            <site name="tail_tip" pos="0.140 0 0" size="0.007" rgba="1 0.8 0.1 1"/>
          </body>
        </body>
      </body>
    </body>
  </worldbody>

  <actuator>
    <!-- Control values are desired joint angles in radians. -->
    <position name="servo_1" class="crawler_servo" joint="joint_1"/>
    <position name="servo_2" class="crawler_servo" joint="joint_2"/>
    <position name="servo_3" class="crawler_servo" joint="joint_3"/>
  </actuator>

  <sensor>
    <!-- Joint feedback matching the three modified physical servos. -->
    <jointpos name="joint_1_pos" joint="joint_1"/>
    <jointpos name="joint_2_pos" joint="joint_2"/>
    <jointpos name="joint_3_pos" joint="joint_3"/>

    <jointvel name="joint_1_vel" joint="joint_1"/>
    <jointvel name="joint_2_vel" joint="joint_2"/>
    <jointvel name="joint_3_vel" joint="joint_3"/>

    <!-- IMU measurements in the imu_site frame. -->
    <accelerometer name="imu_lin_acc" site="imu_site"/>
    <gyro name="imu_ang_vel" site="imu_site"/>
    <framezaxis name="imu_upvector"
                objtype="body" objname="world"
                reftype="site" refname="imu_site"/>
    <subtreecom name="whole_body_com" body="segment_0"/>

  </sensor>

</mujoco>
